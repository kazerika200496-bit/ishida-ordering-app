// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id                String   @id
  materialCode      String?  @unique
  category          String
  name              String
  displayName       String?
  unit              String
  price             Float?
  imageUrl          String?
  defaultSupplierId String?
  orderLines        VendorOrderLine[]
}

model Location {
  id                String   @id
  name              String
  type              String   // '店舗' | '工場'
  defaultSupplierId String?
  users             User[]
}

model User {
  id         String    @id @default(uuid())
  username   String    @unique
  password   String
  role       String    @default("store") // 'admin' | 'store'
  locationId String?   // 店舗ユーザーの場合は紐づくLocationのID
  location   Location? @relation(fields: [locationId], references: [id])
  receipts   Receipt[] // 作成した領収書リレーション
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Supplier {
  id                String   @id
  name              String
  type              String   // '工場' | '業者'
  officialName      String?
  zip               String?
  address           String?
  tel               String?
  fax               String?
  method            String?  // '訪問' | 'FAX' | 'TEL'
  
  // 業者マスタ拡張
  deliveryDayOfWeek String?  // 例: '火'
  cutoffDayOfWeek   String?  // 例: '月'
  cutoffTime        String?  // 例: '17:00'
  orders            VendorOrder[]
}

model VendorOrder {
  id            String            @id
  vendorId      String
  vendor        Supplier          @relation(fields: [vendorId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  deliveryDate  DateTime?         // 納品予定日
  cutoffAt      DateTime?         // 締切日時
  status        String            @default("DRAFT") // 'DRAFT' | 'CONFIRMED' | 'SENT'
  isLocked      Boolean           @default(false)   // 確定後のロック用
  confirmedAt   DateTime?
  confirmedBy   String?
  lines         VendorOrderLine[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model VendorOrderLine {
  id            Int         @id @default(autoincrement())
  orderId       String
  order         VendorOrder @relation(fields: [orderId], references: [id])
  itemId        String
  item          Item        @relation(fields: [itemId], references: [id])
  itemName      String      // デナリゼーション用 (品目名が変わっても注文時は変わらないように)
  qty           Float
  unit          String
  price         Float
  note          String?
  createdBy     String?     // 後方互換性用
  requestedBy   String?     // 入力した人
  locationId    String?     // 拠点ID
  addedAt       DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum ReceiptStatus {
  UPLOADED
  OCR_DONE
  NEEDS_REVIEW
  CONFIRMED
  EXPORT_READY
}

model Receipt {
  id            String    @id @default(cuid())
  
  // Vercel Blob (Private) 画像関連
  imageUrl      String    // ダウンロード/閲覧用URL (Private想定)
  blobPathname  String?   // Vercel Blob 内部パス (削除・操作用)
  contentType   String?   // 画像のMIME Type (例: image/jpeg)
  fileName      String?   // 元ファイル名
  fileSize      Int?      // ファイルサイズ(Bytes)

  // OCR抽出関連
  payee         String?   // OCR抽出: 支払先（店名）
  amount        Int?      // OCR抽出: 合計金額
  receiptDate   DateTime? // OCR抽出: 領収日付
  currency      String?   // OCR抽出: 通貨 (例: JPY)
  taxAmount     Int?      // OCR抽出: 消費税額
  ocrProvider   String?   // OCRエンジン種別 (例: 'document-ai')
  ocrProcessedAt DateTime?// OCR処理完了日時
  rawOcrData    Json?     // OCR抽出: Document AI の生JSON
  reviewNote    String?   // 確認時の修正メモや特記事項
  memo          String?   // フリーメモ
  paymentMethod String?   // 支払方法（現金、クレカ等）

  // 新規追加フィールド（経理用）
  slipNo        String?   // 伝票No.
  accountCode   String?   // 科目コード (例: '743')
  accountName   String?   // 科目名 (例: '消耗品費')
  subAccount    String?   // 補助科目
  description   String?   // 摘要
  taxCategory   String?   // 税区分

  // ステータスと追跡
  status        ReceiptStatus @default(UPLOADED) // enum化
  createdById   String?   // 作成者（アップロードしたユーザー）
  createdBy     User?     @relation(fields: [createdById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
